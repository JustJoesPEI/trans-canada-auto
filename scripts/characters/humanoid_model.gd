class_name HumanoidModel
extends Node3D
## A person: one smooth skinned mesh on a small skeleton, with a procedural walk.
##
## Normal adult proportions (about 1.75 m, head about 1/7.5 of height). The
## body is generated by BodyBuilder as a single mesh, so each person is one
## draw call however detailed. Used for the player now and pedestrians later:
## give each one a different look with set_appearance() before adding it to
## the scene, then call set_motion() every physics frame. Faces -Z, feet at y = 0.
##
## The walk is driven by speed, not by a fixed clip: cadence and stride are
## worked out so the feet roughly keep pace with the ground, and it blends
## smoothly from standing, to a stroll, to a walk, to a run.

@export var height := 1.75
@export var skin := Color(0.87, 0.69, 0.57)
@export var hair := Color(0.23, 0.16, 0.11)
@export var top := Color(0.66, 0.16, 0.13) ## jacket: red, so the player reads against grey streets
@export var under := Color(0.82, 0.8, 0.74) ## shirt showing at the collar
@export var bottom := Color(0.21, 0.25, 0.34) ## trousers
@export var shoes := Color(0.16, 0.12, 0.1)
@export_range(0.85, 1.2) var build := 1.0 ## shoulder and chest width
@export_enum("Short", "Long", "Close-cropped") var hair_style := 0
@export var hat := Color(0, 0, 0, 0) ## knit hat colour; alpha 0 = no hat
## What they're wearing (see Outfit). When empty, the colours above make a
## jacket, jeans and sneakers (and a toque if the hat colour is set).
var outfit: Dictionary = {}
## Extras on the face: "sideburns" (true) and "shades" (the lenses' colour:
## aviators). Tenner has both (GarageTest); nobody else yet.
var face_extras: Dictionary = {}
## Hide beyond this many metres from the camera (0 = always draw). Handy for crowds.
@export var draw_distance := 0.0
## Past this from the camera (m), posed every third frame.
const FAR_POSE := 40.0
var _held_dt := 0.0
var _held_frames := 0
## People who share a look (officers in uniform) can share one built body:
## a key here caches the mesh by it (the same key must mean the same look).
var mesh_cache_key := ""
## Armour plates worn (0..3), shown as a plate carrier: set with
## set_armour_plates (BodyPaint does, as plates are bought and broken).
var armour_plates := 0
static var _mesh_cache := {}

const LEG := 0.9 # hip to sole, metres, for a 1.75 m person

## Sitting (driving): a fixed seated pose with hands on the wheel.
var seated := false
## With `seated`: sitting on the ground instead of a seat, legs out in
## front and hands back on the ground behind (someone knocked down, being
## seen to by a paramedic). The owner lowers the model so the hips touch the
## ground (`ground_sit_drop`).
var ground_sit := false
## -1..1 steering, so the hands follow the wheel while seated.
var seated_steer := 0.0
## While seated, where the hands hold the steering wheel: [left grip, right
## grip, wheel hub], in this model's own space. Empty: a fixed driving pose.
var seated_grips: Array = []
## Seated in a passenger seat, leaning out of the window to shoot
## (PassengerSeat): 0 sitting, 1 sitting up on the window sill with the
## upper body out, turned toward the aim, marker up. The model is moved
## onto the sill by PassengerSeat; this bends the body.
var seated_lean := 0.0
## Which window: 1 the right (the passenger's side), -1 the left.
var seated_side := 1.0
## Where the aim is, as a turn from straight ahead (radians, left
## positive), for the lean's twist; `aim_pitch` is up and down.
var seated_aim_yaw := 0.0
## While seated, where the feet rest: [left, right] ankle points in this
## model's own space. Empty: legs at right angles.
var seated_feet: Array = []
## Shrink the head away, for the driver's-seat view: the camera sits where
## the eyes are, so the body (hands on the wheel) stays in view without the
## inside of the head in the way.
var hide_head := false

## Which way they're stepping, relative to the way they face (radians, 0
## ahead, positive to the left, PI straight back): strafing and backing up
## while aiming. Set it with set_motion every physics frame.
var move_angle := 0.0
## 0..1, how far into the aiming pose (both hands up on a marker, upper
## body on target). Eased on its own, so it can simply be set to 0 or 1.
var aim := 0.0
## Aim up (positive) or down, radians.
var aim_pitch := 0.0
## 0..1: hands up (painted out of a paintball game: "you just stand there,
## painted, looking annoyed"). Eased on its own; overrides the arms.
var hands_up := 0.0
## 0..1: curled up in a ball, knees to the chest and arms round the shins
## (the dodge roll: PlayerController turns the tucked body over). Set
## straight, not eased; overrides the whole pose.
var tuck := 0.0
## 0..1 through a reload while one is being shown (the left hand fetches a
## pod from the belt and pours it into the hopper), or -1. Brings the
## marker up to a low ready while it plays, even when not aiming.
var reload := -1.0
## The marker in hand has a scope (MarkerModel.mesh(true)).
var scoped := false
## What the hands are busy with (blended in and out, a prop in hand where
## there is one: HandProps). Standing or seated:
##   "radio"        talking into the shoulder mic, head turned to it
##   "notepad"      writing in a notebook (paperwork, the report)
##   "phone"        looking at a phone in both hands (the overtime)
##   "call"         a phone to the ear (the union rep)
##   "arms_crossed"
## Standing only (the legs are part of it):
##   "kneel"        down on one knee, the right hand out to `task_at`
##   "rinse"        down on one knee, a spray bottle at `task_at`
##   "hose_drag"    a hose over the right shoulder, leaning into it
##   "hose"         the nozzle in both hands: braced and aimed at
##                  `task_at`, or held low (INF) at the ready
var task := ""
## Where the task is aimed (world): the patient, what the hose is on.
var task_at := Vector3.INF

var skeleton: Skeleton3D
var mesh_instance: MeshInstance3D
var _rest: Array[Vector3] = []

var _phase := 0.0
var _speed := 0.0 # smoothed
var _target_speed := 0.0
var _accel := 0.0 # smoothed, m/s per second along facing
var _turn := 0.0 # smoothed, radians per second
var _target_accel := 0.0
var _target_turn := 0.0
var _t := 0.0
var _k := 1.0 # scale factor for height
var _stride := 0.0 # 0..1, how much the legs are stepping; outlasts the speed on a stop so the last step lands
var _lean := 0.0 # torso pitch from speeding up and slowing down, on a bouncy spring
var _lean_vel := 0.0
var _sink := 0.0 # hips lowered by a hard stop or a start, on a bouncy spring
var _sink_vel := 0.0
var _move_dir := Vector2(0.0, 1.0) # smoothed move_angle as (sin, cos), so it never spins the long way
var _backward := false # stepping backward: the walk runs in reverse
var _hip_yaw := 0.0 # lower body turned toward a sideways step
var _aim_t := 0.0 # smoothed aim
var _aim_pitch := 0.0
var _gun_yaw := 0.0 # leaning out of a window: the marker's turn from straight ahead
var _marker: MeshInstance3D # made the first time they aim
var _pod: MeshInstance3D # the paint pod in the left hand, on a reload
var _reload_t := 0.0 # eased weight of the reload pose
var _hands_t := 0.0 # smoothed hands_up
var _recoil := 0.0 # 1 on a shot, easing back: the marker jolts back and up
var _flinch := Vector2.ZERO # x: chest tipped back (+) or forward, y: rolled, on a bouncy spring
var _flinch_vel := Vector2.ZERO
var _flinch_head := 0.0 # a head hit snaps the head back too
var _task_now := "" # the task being shown (task, once the last one has eased out)
var _task_t := 0.0 # its eased weight
var _props: Array[MeshInstance3D] = [null, null] # in the left and right hands
var _tip := Transform3D.IDENTITY # the business end of the right hand's prop (skeleton space)
var _hose_pts: Array[Vector3] = [] # where a held hose runs over the body (skeleton space)
# Getting into or out of a seat (climb_in, climb_out): -1 not climbing,
# else 0 standing at the door .. 1 sat down.
var _climb_u := -1.0
var _climb_dir := 0.0 # +1 getting in, -1 getting out
var _climb_walk := 0.0 # s left of the walk to the door first
var _climb_from := Vector3.ZERO # where that walk starts (the seated frame)
var _climb_door := Vector3.ZERO # the spot at the door (the seated frame)
var _climb_seat := Transform3D.IDENTITY # the seated frame, in the parent's space
var _climb_yaw0 := 0.0 # the way they face standing at the door (the seated frame)


func _ready() -> void:
	_build()


## How far down to move the model for `ground_sit`, so the hips are on
## the ground (m, negative).
func ground_sit_drop() -> float:
	return -LEG * _k + 0.1


## Pick colours before the model is added to the tree.
func set_appearance(appearance: Dictionary) -> void:
	skin = appearance.get("skin", skin)
	hair = appearance.get("hair", hair)
	top = appearance.get("top", top)
	under = appearance.get("under", under)
	bottom = appearance.get("bottom", bottom)
	shoes = appearance.get("shoes", shoes)
	height = appearance.get("height", height)
	build = appearance.get("build", build)
	hair_style = appearance.get("hair_style", hair_style)
	hat = appearance.get("hat", hat)
	outfit = appearance.get("outfit", outfit)
	for key: String in ["sideburns", "shades"]:
		if appearance.has(key):
			face_extras[key] = appearance[key]


## Change clothes. Works before or after the person is in the scene: the
## mesh is rebuilt (a few milliseconds), the pose carries on.
func set_outfit(new_outfit: Dictionary) -> void:
	outfit = Outfit.complete(new_outfit)
	if mesh_instance != null:
		mesh_instance.mesh = _body_mesh(_builder())


## Show `n` armour plates (0 takes the carrier off). Rebuilds the body
## mesh, like a change of clothes, only when the count changes.
func set_armour_plates(n: int) -> void:
	n = clampi(n, 0, 3)
	if n == armour_plates:
		return
	armour_plates = n
	if mesh_instance != null:
		mesh_instance.mesh = _body_mesh(_builder())


## Change the whole look (skin, hair, height, build, outfit) of a person
## already in the scene: the body and skeleton are rebuilt (height changes
## the bones), the walk and pose carry on.
func set_look(appearance: Dictionary) -> void:
	set_appearance(appearance)
	outfit = Outfit.complete(outfit)
	if skeleton == null:
		return
	remove_child(skeleton)
	skeleton.free()
	skeleton = null
	mesh_instance = null
	_rest.clear()
	_build()


## A random everyday look, seeded so a pedestrian keeps theirs.
static func random_appearance(rng: RandomNumberGenerator) -> Dictionary:
	var skins := [Color(0.95, 0.8, 0.69), Color(0.87, 0.69, 0.57), Color(0.76, 0.57, 0.43), Color(0.58, 0.4, 0.28), Color(0.4, 0.27, 0.19)]
	var hairs := [Color(0.1, 0.08, 0.07), Color(0.23, 0.16, 0.11), Color(0.45, 0.3, 0.18), Color(0.72, 0.58, 0.36), Color(0.62, 0.6, 0.58)]
	return {
		"skin": skins[rng.randi() % skins.size()],
		"hair": hairs[rng.randi() % hairs.size()],
		"height": rng.randf_range(1.6, 1.88),
		"build": rng.randf_range(0.9, 1.12),
		"hair_style": rng.randi() % 3,
		"outfit": Outfit.random(rng),
	}


## Call every physics frame.
## speed: m/s over the ground. accel: m/s² along the way the person faces
## (positive when speeding up). turn: radians per second, positive to the left.
## angle: the way they're stepping, relative to the way they face (see
## move_angle).
func set_motion(speed: float, accel := 0.0, turn := 0.0, angle := 0.0) -> void:
	_target_speed = speed
	move_angle = angle
	_target_accel = accel
	_target_turn = turn
	# Lean into turns only when running: people walk round corners by
	# stepping, not by tipping over, and leaning at a walk made every small
	# heading correction rock the whole body. Set here (a physics step)
	# rather than per frame, so physics interpolation keeps it smooth.
	var run := smoothstep(2.6, 4.6, speed / _k)
	var lean := clampf(atan(turn * speed / 9.8) * 0.6 * run, -0.15, 0.15)
	rotation.z = lerpf(rotation.z, lean, 0.12)


func _process(delta: float) -> void:
	if skeleton == null:
		return
	# Posing is a few dozen bones set by hand each frame: not at all past
	# where the body is drawn, and every third frame (with the time since)
	# past FAR_POSE, where a step's detail can't be seen.
	# (In the game's own view only: the character creator's preview has its
	# own camera.)
	var cam := Car.camera_position(self) if get_viewport() == get_tree().root else Vector3.INF
	if cam != Vector3.INF:
		var d2 := cam.distance_squared_to(global_position)
		if draw_distance > 0.0 and d2 > (draw_distance + 5.0) * (draw_distance + 5.0):
			_held_dt = minf(_held_dt + delta, 0.25)
			end_climb() # nobody to see it: straight to the end
			return
		if d2 > FAR_POSE * FAR_POSE:
			_held_dt += delta
			_held_frames += 1
			if _held_frames < 3:
				return
		delta += _held_dt
		_held_dt = 0.0
		_held_frames = 0
	_t += delta
	if _climb_u >= 0.0:
		_climb_step(delta)
	if seated and _climb_u < 0.0:
		_seated_pose()
		if seated_lean > 0.001:
			# Leaning out of a passenger seat with the marker up.
			_aim_t = move_toward(_aim_t, maxf(aim, RELOAD_READY if reload >= 0.0 else 0.0), delta / 0.14)
			_aim_pitch = lerpf(_aim_pitch, aim_pitch if aim > 0.0 else 0.0, 1.0 - exp(-25.0 * delta))
			_reload_t = move_toward(_reload_t, 1.0 if reload >= 0.0 else 0.0, delta / 0.12)
			_step_hits(delta)
			_lean_out_pose()
			_hold_marker()
			return
		_aim_t = 0.0
		_reload_t = 0.0
		_gun_yaw = 0.0
		if _marker != null:
			_marker.visible = false
		if _pod != null:
			_pod.visible = false
		_task_pose(delta, true)
		_hands_up_pose(delta)
		return
	skeleton.set_bone_pose_scale(BodyBuilder.HEAD, Vector3.ONE)
	_gun_yaw = 0.0
	_speed = lerpf(_speed, _target_speed, 1.0 - exp(-12.0 * delta))
	_accel = lerpf(_accel, clampf(_target_accel, -14.0, 14.0), 1.0 - exp(-10.0 * delta))
	_turn = lerpf(_turn, clampf(_target_turn, -6.0, 6.0), 1.0 - exp(-8.0 * delta))
	var s := maxf(0.0, _speed) / _k
	# A reload brings the marker up to a low ready if it isn't up already.
	_aim_t = move_toward(_aim_t, maxf(aim, RELOAD_READY if reload >= 0.0 else 0.0), delta / 0.14)
	_aim_pitch = lerpf(_aim_pitch, aim_pitch if aim > 0.0 else 0.0, 1.0 - exp(-25.0 * delta))
	_reload_t = move_toward(_reload_t, 1.0 if reload >= 0.0 else 0.0, delta / 0.12)

	# Stepping direction: forward, sideways or backward. Backing up runs the
	# walk in reverse with the hips toward the front; sideways, the hips turn
	# part of the way toward the step and the legs reach out the rest, while
	# the chest turns back to face ahead.
	var want_dir := Vector2(sin(move_angle), cos(move_angle)) if s > 0.15 else Vector2(0.0, 1.0)
	_move_dir = _move_dir.lerp(want_dir, 1.0 - exp(-14.0 * delta))
	var dir_angle := atan2(_move_dir.x, _move_dir.y)
	if _backward and cos(dir_angle) > 0.25:
		_backward = false
	elif not _backward and cos(dir_angle) < -0.25:
		_backward = true
	var stepping := wrapf(dir_angle - (PI if _backward else 0.0), -PI, PI) # where the legs go, hip-forward frame
	var dir_sign := -1.0 if _backward else 1.0
	var hip_yaw_goal := clampf(stepping * 0.7, -1.0, 1.0)
	_hip_yaw = lerpf(_hip_yaw, hip_yaw_goal, 1.0 - exp(-10.0 * delta))
	var reach := stepping - _hip_yaw # what the legs swing out on top of the hips' turn
	var fwd_amount := clampf(cos(dir_angle), 0.0, 1.0) # 1 straight ahead: only then lean into a run

	# Stepping comes on with speed straight away, but on a stop it carries on
	# for the last step, so the trailing foot comes through and lands beside
	# the other instead of the stride shrinking on the spot.
	var want := clampf(s / 0.9, 0.0, 1.0)
	if want >= _stride:
		_stride = want
	else:
		_stride = maxf(want, _stride - delta * 3.2)
		# Finish on a plant: both feet under the body (phase 0 or PI).
		if want < 0.05:
			var to_plant := fposmod(-_phase, PI) # phase still to go to the next plant
			if to_plant > 0.02:
				if to_plant < PI * 0.65:
					_stride = maxf(_stride, minf(1.0, to_plant * 0.9))
	var moving := _stride # 0 standing .. 1 walking
	var run := smoothstep(2.6, 4.4, s) # 0 walking .. 1 running
	# Cycles per second (two steps each): about 1.9 steps/s walking, 2.9 running.
	var cadence := clampf(0.55 + 0.22 * s, 0.85, 1.45)
	_phase = fmod(_phase + TAU * cadence * delta * moving, TAU)
	# Hip swing that roughly matches stride to speed, so the feet keep pace
	# with the ground. (Scaled down: the knee and ankle bends add to it.)
	var swing := asin(clampf(s / (4.0 * LEG * cadence), 0.0, 0.72)) * lerpf(0.78, 0.72, run)
	swing = maxf(swing, 0.12 * moving) # the last step still has some reach

	# Weight: starting and stopping tip the body (forward on a start, back on
	# a stop) on an underdamped spring, so a stop rocks back and settles with
	# a little overshoot; a hard stop or a burst of speed also dips the hips.
	var lean_goal := clampf(_accel * 0.022, -0.14, 0.17)
	var sl := _bouncy(_lean, _lean_vel, lean_goal, 13.0, 0.42, delta)
	_lean = sl[0]
	_lean_vel = sl[1]
	var sink_goal := clampf(absf(_accel) * 0.0022, 0.0, 0.03)
	var sk := _bouncy(_sink, _sink_vel, sink_goal, 16.0, 0.45, delta)
	_sink = sk[0]
	_sink_vel = sk[1]

	var impact := 0.0 # hips dip just after each foot lands
	for side in 2:
		var p := _phase + (PI if side == 1 else 0.0)
		var forward := sin(p) * dir_sign # +1 leg fully toward the step
		var swinging := maxf(0.0, cos(p) * dir_sign) # leg travelling toward the step through the air
		# Time since this foot landed (it lands at full reach, p = PI/2): the
		# knee gives a little to take the weight, then straightens.
		var since := fposmod(p - PI * 0.5, TAU)
		var load := smoothstep(0.0, 0.25, since) * (1.0 - smoothstep(0.25, 1.1, since)) * moving
		impact = maxf(impact, load)
		var hip_x := forward * swing * cos(reach) + run * 0.15 * dir_sign
		var hip_z := -forward * swing * sin(reach) * 0.6 # legs reach less to the side than ahead
		var knee := -(0.06 + swinging * lerpf(0.75, 1.7, run) * swing * 1.6) * moving
		knee -= run * 0.25 * maxf(0.0, -forward)
		knee -= load * lerpf(0.2, 0.4, run)
		var ankle := -(hip_x + knee) * 0.85
		if forward < -0.4:
			ankle += (forward + 0.4) * -0.5 * moving # push off with the toe
		var leg := BodyBuilder.UPPER_LEG_L if side == 0 else BodyBuilder.UPPER_LEG_R
		# Standing, the feet are a little apart; walking, they land close to
		# a single line under the body instead of waddling wide.
		# Stepping sideways, they stay a little wider so the legs don't cross.
		var inward := lerpf(-0.025, 0.012 + 0.012 * run, moving) - 0.06 * absf(sin(reach)) * moving
		_rot(leg, Vector3(hip_x, 0.0, hip_z + (inward if side == 0 else -inward)))
		_rot(leg + 1, Vector3(knee, 0.0, 0.0))
		_rot(leg + 2, Vector3(ankle, 0.0, 0.0))

		# Arms swing with the opposite leg; elbows bend more when running.
		# The swing is a little behind the legs (the arms are pendulums, pulled
		# along by the shoulders), more forward than back, and the arms come
		# in toward the body as they swing forward. A shade bigger than life.
		var arm_swing := lerpf(0.36, 0.8, run) * moving * clampf(swing / 0.45, 0.4, 1.2)
		var other := sin(p + PI - 0.25)
		# Arms swing forward a little on a stop and back on a start, with the lean.
		var arm_x := other * arm_swing + 0.06 * moving - run * 0.12 - _lean * 0.8
		var arm := BodyBuilder.UPPER_ARM_L if side == 0 else BodyBuilder.UPPER_ARM_R
		var out := 0.03 + 0.05 * run - maxf(0.0, other) * 0.04 * moving
		_rot(arm, Vector3(arm_x, 0.0, -out if side == 0 else out))
		_rot(arm + 1, Vector3(0.12 + moving * 0.18 + run * 1.25 + maxf(0.0, other) * 0.3 * moving, 0.0, 0.0))

	# Hips. The right leg is in mid-stance at phase 0 and the left at PI.
	# Bob: highest over the planted foot walking, in the air running, with a
	# small dip as each foot takes the weight. Shift: a little over the
	# planted foot. Drop: the side of the swinging leg dips a few degrees.
	# Twist: the hip of the leg going forward goes forward with it. All
	# small: they read as weight, not as sway.
	var bob_amp := lerpf(0.016, -0.04, run) * moving
	var breathe := sin(_t * 1.7) * 0.006 * (1.0 - moving)
	var idle_shift := sin(_t * 0.45) * 0.008 * (1.0 - moving)
	var c := cos(_phase)
	var sideways := 0.012 * c * moving * (1.0 - run * 0.6)
	var hip_drop := 0.05 * c * moving * (1.0 - run * 0.4)
	var hip_twist := -0.08 * sin(_phase) * moving * (1.0 + run * 0.5)
	var height := -0.012 * moving - 0.06 * run + bob_amp * cos(2.0 * _phase) - impact * lerpf(0.012, 0.02, run) - _sink
	skeleton.set_bone_pose_position(BodyBuilder.HIPS, _rest[BodyBuilder.HIPS] + Vector3(idle_shift + sideways, height, 0.0))
	_rot(BodyBuilder.HIPS, Vector3(-_lean * 0.25, hip_twist + _hip_yaw, hip_drop))
	# The spine takes the hip drop back out so the shoulders stay level, and
	# turns the shoulders the other way from the hips, with the arms.
	# Aiming, the shoulders stay square (a steady aim) and the chest tips
	# back a little to aim up, forward to aim down.
	var lean := 0.035 * moving + 0.24 * run * lerpf(0.25, 1.0, fwd_amount) + _lean * 0.75
	var twist := 0.13 * sin(_phase - 0.2) * moving * (1.0 + run * 0.6) * (1.0 - 0.75 * _aim_t)
	var aim_tilt := _aim_pitch * 0.3 * _aim_t
	_step_hits(delta)
	var fl := _flinch
	_rot(BodyBuilder.SPINE, Vector3(-lean * 0.5 + breathe + aim_tilt * 0.5 + fl.x * 0.5, -hip_twist * 0.5 + twist * 0.5 - _hip_yaw * 0.6, -hip_drop * 0.75 + fl.y * 0.5))
	_rot(BodyBuilder.CHEST, Vector3(-lean * 0.5 + aim_tilt * 0.5 + fl.x * 0.5, -hip_twist * 0.5 + twist * 0.5 - _hip_yaw * 0.4, -hip_drop * 0.25 + fl.y * 0.5))
	skeleton.set_bone_pose_scale(BodyBuilder.CHEST, Vector3(1.0 + breathe, 1.0 + breathe, 1.0 + breathe * 2.0))
	# Keep the head steady, level and looking ahead (it lags the lean a
	# little); aiming, it looks up or down along the aim.
	var look := (_aim_pitch * 0.7 - aim_tilt) * _aim_t
	_rot(BodyBuilder.NECK, Vector3(lean * 0.4 + look * 0.4, -twist * 0.5, 0.0))
	_rot(BodyBuilder.HEAD, Vector3(lean * 0.3 - _lean_vel * 0.004 + look * 0.6 + _flinch_head * 0.35, -twist * 0.5, 0.0))

	_hold_marker()
	if _climb_u >= 0.0:
		_climb_blend()
	_task_pose(delta, false)
	_hands_up_pose(delta)
	if tuck > 0.001:
		_tuck_pose(smoothstep(0.0, 1.0, tuck))


## Out: both hands up, a little out to the sides, elbows a touch bent.
func _hands_up_pose(delta: float) -> void:
	_hands_t = move_toward(_hands_t, hands_up, delta / 0.3)
	if _hands_t > 0.001:
		var e := smoothstep(0.0, 1.0, _hands_t)
		for side in 2:
			var arm := BodyBuilder.UPPER_ARM_L if side == 0 else BodyBuilder.UPPER_ARM_R
			var up_q := Quaternion.from_euler(Vector3(2.75, 0.0, -0.35 if side == 0 else 0.35))
			skeleton.set_bone_pose_rotation(arm, skeleton.get_bone_pose_rotation(arm).slerp(up_q, e))
			skeleton.set_bone_pose_rotation(arm + 1, skeleton.get_bone_pose_rotation(arm + 1).slerp(Quaternion.from_euler(Vector3(0.35, 0.0, 0.0)), e))
			skeleton.set_bone_pose_rotation(arm + 2, skeleton.get_bone_pose_rotation(arm + 2).slerp(Quaternion.IDENTITY, e))


## Arms: blend from the walk's swing (or the seated pose) into holding a
## marker up to the right shoulder, aimed along the view. It comes up from
## low in the hands as the aim comes on.
func _hold_marker() -> void:
	var gun := _marker_xform(_aim_pitch, _aim_t)
	if _reload_t > 0.001:
		# Reloading: the marker dips and rolls toward you, hopper up, so the
		# left hand can get to it.
		var e := smoothstep(0.0, 1.0, _reload_t)
		var dir := -gun.basis.z
		gun.basis = Basis(dir, -0.45 * e) * Basis(gun.basis.x, -0.22 * e) * gun.basis
	if _aim_t > 0.001 and _marker == null:
		_marker = MeshInstance3D.new()
		_marker.name = "Marker"
		_marker.mesh = MarkerModel.mesh()
		skeleton.add_child(_marker)
	if _marker != null:
		var want := MarkerModel.mesh(scoped)
		if _marker.mesh != want:
			_marker.mesh = want
		_marker.visible = _aim_t > 0.001
		_marker.transform = gun
	for side in 2:
		var arm := BodyBuilder.UPPER_ARM_L if side == 0 else BodyBuilder.UPPER_ARM_R
		if _aim_t <= 0.001:
			skeleton.set_bone_pose_rotation(arm + 2, Quaternion.IDENTITY)
			continue
		# The hands get to the marker early in the raise and stay on it.
		var w := minf(1.0, _aim_t * 4.0)
		var q: Array = _aim_arm(side, gun)
		for b in 2:
			var walk_q := skeleton.get_bone_pose_rotation(arm + b)
			skeleton.set_bone_pose_rotation(arm + b, walk_q.slerp(q[b], w))
		skeleton.set_bone_pose_rotation(arm + 2, Quaternion.IDENTITY.slerp(q[2], w))

	_reload_pose(gun)


## The ball for a roll: the back curled, the head down, the knees up to
## the chest and the arms wrapped round the shins, blended in by `e`.
func _tuck_pose(e: float) -> void:
	var to := {
		BodyBuilder.SPINE: Vector3(-0.7, 0.0, 0.0), BodyBuilder.CHEST: Vector3(-0.55, 0.0, 0.0),
		BodyBuilder.NECK: Vector3(-0.45, 0.0, 0.0), BodyBuilder.HEAD: Vector3(-0.3, 0.0, 0.0),
	}
	for side in 2:
		var leg := BodyBuilder.UPPER_LEG_L if side == 0 else BodyBuilder.UPPER_LEG_R
		var arm := BodyBuilder.UPPER_ARM_L if side == 0 else BodyBuilder.UPPER_ARM_R
		var s := -1.0 if side == 0 else 1.0
		to[leg] = Vector3(2.15, 0.0, 0.12 * s)
		to[leg + 1] = Vector3(-2.35, 0.0, 0.0)
		to[leg + 2] = Vector3(0.45, 0.0, 0.0)
		to[arm] = Vector3(1.1, 0.0, -0.25 * s)
		to[arm + 1] = Vector3(1.35, 0.0, 0.0)
	for b: int in to:
		var q := Quaternion.from_euler(to[b])
		skeleton.set_bone_pose_rotation(b, skeleton.get_bone_pose_rotation(b).slerp(q, e))


## A shot: the marker jolts back into the shoulder and the muzzle climbs,
## and settles in about a tenth of a second (the arms follow it).
func recoil(amount := 1.0) -> void:
	_recoil = maxf(_recoil, amount)


## Hit by a ball going `dir` (world): the chest is knocked the way the
## ball went and rocks back, quick and small, so a hit reads on the body
## from across a lot. `head`: the head snaps back as well.
func flinch(dir: Vector3, amount := 1.0, head := false) -> void:
	var local := global_basis.inverse() * dir
	# Forward is -Z: a ball going +Z (hit from the front) tips the chest
	# back (+x in the spine's pitch); one going sideways rolls it.
	_flinch_vel += Vector2(local.z * 7.0, -local.x * 6.0) * amount
	if head:
		_flinch_head = 1.0


## An underdamped spring step (frequency in rad/s, damping ratio below 1
## overshoots). Returns [value, velocity].
static func _bouncy(x: float, v: float, goal: float, freq: float, damping: float, delta: float) -> Array:
	# Semi-implicit Euler in small steps, so it's stable at any frame rate.
	var steps := maxi(1, ceili(delta / 0.008))
	var h := delta / float(steps)
	for i in steps:
		v += (-freq * freq * (x - goal) - 2.0 * damping * freq * v) * h
		x += v * h
	return [x, v]


## Hips and knees bent at right angles, back against the seat, hands on
## the wheel and turning it a little with the steering.
func _seated_pose() -> void:
	skeleton.set_bone_pose_position(BodyBuilder.HIPS, _rest[BodyBuilder.HIPS])
	_rot(BodyBuilder.HIPS, Vector3.ZERO)
	_rot(BodyBuilder.SPINE, Vector3(0.12, 0.0, 0.0))
	_rot(BodyBuilder.CHEST, Vector3(0.0, 0.0, 0.0))
	skeleton.set_bone_pose_scale(BodyBuilder.CHEST, Vector3.ONE)
	_rot(BodyBuilder.NECK, Vector3(-0.1, 0.0, 0.0))
	_rot(BodyBuilder.HEAD, Vector3(0.0, seated_steer * 0.15, 0.0))
	skeleton.set_bone_pose_scale(BodyBuilder.HEAD, Vector3.ONE * (0.001 if hide_head else 1.0))
	for side in 2:
		var leg := BodyBuilder.UPPER_LEG_L if side == 0 else BodyBuilder.UPPER_LEG_R
		if ground_sit:
			_rot(leg, Vector3(1.45, 0.0, (-0.14 if side == 0 else 0.14)))
			_rot(leg + 1, Vector3(-0.18, 0.0, 0.0))
			_rot(leg + 2, Vector3(-0.35, 0.0, 0.0))
		elif seated_feet.size() == 2:
			_reach_leg(side, seated_feet[side])
		else:
			_rot(leg, Vector3(1.4, 0.0, (-0.08 if side == 0 else 0.08)))
			_rot(leg + 1, Vector3(-1.25, 0.0, 0.0))
			_rot(leg + 2, Vector3(0.1, 0.0, 0.0))
		var arm := BodyBuilder.UPPER_ARM_L if side == 0 else BodyBuilder.UPPER_ARM_R
		if ground_sit:
			_rot(arm, Vector3(-0.55, 0.0, (0.35 if side == 0 else -0.35)))
			_rot(arm + 1, Vector3(0.1, 0.0, 0.0))
		elif seated_grips.size() == 3:
			_reach_arm(side, seated_grips[side], seated_grips[2])
		else:
			var turn := seated_steer * (0.25 if side == 0 else -0.25)
			_rot(arm, Vector3(0.95 + turn, 0.0, (0.03 if side == 0 else -0.03)))
			_rot(arm + 1, Vector3(0.55, 0.0, 0.0))
	rotation.z = 0.0


## Leaning out of a passenger window (on top of the seated pose): the hips
## turn toward the window, the body tips out over the sill and twists the
## rest of the way to the aim, the head follows it. Big, simple shapes, so
## it reads from a chase camera: someone is hanging out of that car.
func _lean_out_pose() -> void:
	var e := smoothstep(0.0, 1.0, seated_lean)
	var side := signf(seated_side) if seated_side != 0.0 else 1.0
	# How far round the aim is, from the window's way (straight out is
	# -side * PI/2 from ahead): the hips take a little, the spine and chest
	# the rest, as far as a body twists (about 70 degrees each way).
	var out_yaw := -side * PI * 0.5
	var hips_yaw := out_yaw * 0.35 * e
	var twist := clampf(angle_difference(hips_yaw, seated_aim_yaw), -1.25, 1.25) * e
	_rot(BodyBuilder.HIPS, Vector3(0.0, hips_yaw, -side * 0.12 * e))
	_rot(BodyBuilder.SPINE, Vector3(0.12 * (1.0 - e) + _aim_pitch * 0.15 * e, twist * 0.5, -side * 0.34 * e))
	_rot(BodyBuilder.CHEST, Vector3(_aim_pitch * 0.15 * e, twist * 0.5, -side * 0.14 * e))
	var look := _aim_pitch * 0.5 * _aim_t
	_rot(BodyBuilder.NECK, Vector3(-0.1 * (1.0 - e) + look * 0.4, 0.0, side * 0.2 * e))
	_rot(BodyBuilder.HEAD, Vector3(look * 0.6, 0.0, side * 0.15 * e))
	# The marker points the way the chest faces, and a little further
	# toward the aim (the hands make up the rest), so the arms stay on it.
	var chest_yaw := hips_yaw + twist
	_gun_yaw = chest_yaw + clampf(angle_difference(chest_yaw, seated_aim_yaw), -0.3, 0.3) * e


## Two-bone reach: where the middle joint goes so a limb of lengths l1 and
## l2 from `root` touches `target`, bending toward `pole`.
static func _two_bone(root: Vector3, target: Vector3, l1: float, l2: float, pole: Vector3) -> Array:
	var to := target - root
	var d := clampf(to.length(), absf(l1 - l2) + 0.01, l1 + l2 - 0.004)
	var dir := to.normalized()
	var a := (l1 * l1 - l2 * l2 + d * d) / (2.0 * d)
	var h := sqrt(maxf(l1 * l1 - a * a, 0.0))
	var perp := (pole - dir * pole.dot(dir)).normalized()
	var mid := root + dir * a + perp * h
	return [mid, root + dir * d]


## Global rotation that turns a bone pointing along `rest` (its rest
## direction; every bone's rest basis is the identity) to point along `to`.
static func _aim(rest: Vector3, to: Vector3) -> Basis:
	return Basis(Quaternion(rest.normalized(), to.normalized()))


## Put a hand on the steering wheel: the palm at the grip, elbows down and
## a little out, fingers curled in round the rim toward the hub.
func _reach_arm(side: int, grip: Vector3, hub: Vector3) -> void:
	var up := BodyBuilder.UPPER_ARM_L if side == 0 else BodyBuilder.UPPER_ARM_R
	var chest := skeleton.get_bone_global_pose(BodyBuilder.CHEST)
	var shoulder := chest * _rest[up]
	var l1 := _rest[up + 1].length()
	var l2 := _rest[up + 2].length()
	var palm := 0.07 * _k
	var out := -1.0 if side == 0 else 1.0
	# The palm rests on the driver's side of the rim, just outside it.
	var target := grip + (grip - hub).normalized() * 0.012 + Vector3(0, 0, 0.022)
	var ik := _two_bone(shoulder, target, l1, l2 + palm, Vector3(out * 0.6, -1.0, 0.3))
	var elbow: Vector3 = ik[0]
	var reach: Vector3 = ik[1]
	var g_up := _aim(_rest[up + 1], elbow - shoulder)
	var g_low := _aim(_rest[up + 2], reach - elbow)
	var fingers := ((reach - elbow).normalized() + (hub - grip).normalized() * 0.9).normalized()
	var g_hand := _aim(_rest[up + 2], fingers)
	skeleton.set_bone_pose_rotation(up, (chest.basis.inverse() * g_up).get_rotation_quaternion())
	skeleton.set_bone_pose_rotation(up + 1, (g_up.inverse() * g_low).get_rotation_quaternion())
	skeleton.set_bone_pose_rotation(up + 2, (g_low.inverse() * g_hand).get_rotation_quaternion())


## Where the marker is held, in the skeleton's space: up at the right
## shoulder, the muzzle `pitch` radians up. `t` below 1 holds it lower and
## tipped down, on its way up.
func _marker_xform(pitch: float, t: float) -> Transform3D:
	var chest := skeleton.get_bone_global_pose(BodyBuilder.CHEST)
	var mid := chest * ((_rest[BodyBuilder.UPPER_ARM_L] + _rest[BodyBuilder.UPPER_ARM_R]) * 0.5)
	var p := lerpf(-0.9, pitch, smoothstep(0.0, 1.0, t)) + _recoil * 0.09
	# Turned with the chest when leaning out of a window (_gun_yaw); on
	# foot the whole body turns, so it's straight ahead.
	var turn := Basis(Vector3.UP, _gun_yaw)
	var dir := turn * Vector3(0.0, sin(p), -cos(p))
	var up := turn * Vector3(0.0, cos(p), sin(p))
	var right := turn * Vector3.RIGHT
	var at := mid + right * 0.1 * _k - up * 0.13 * _k + dir * (0.24 - 0.05 * _recoil) * _k
	return Transform3D(Basis(right, up, -dir), at)


## The recoil and the flinch, eased each posed frame.
func _step_hits(delta: float) -> void:
	_recoil *= exp(-delta * 22.0)
	var fx := _bouncy(_flinch.x, _flinch_vel.x, 0.0, 22.0, 0.45, delta)
	var fy := _bouncy(_flinch.y, _flinch_vel.y, 0.0, 22.0, 0.45, delta)
	_flinch = Vector2(fx[0], fy[0])
	_flinch_vel = Vector2(fx[1], fy[1])
	_flinch_head = move_toward(_flinch_head, 0.0, delta * 6.0)


## How far up the marker comes for a reload when not aiming (0..1 of the
## raise, see _marker_xform).
const RELOAD_READY := 0.8

## The pod swap: the left hand leaves the foregrip, takes a pod off the
## left of the belt, brings it up over the hopper, tips it in, shakes it,
## and goes back to the foregrip. Keyed on `reload` (0..1).
func _reload_pose(gun: Transform3D) -> void:
	if _reload_t <= 0.001 or _marker == null:
		if _pod != null:
			_pod.visible = false
		return
	var p := clampf(reload, 0.0, 1.0) if reload >= 0.0 else 1.0
	var hips := skeleton.get_bone_global_pose(BodyBuilder.HIPS)
	var grip := gun * (MarkerModel.FOREGRIP + Vector3(-0.025, -0.01, 0.0))
	var belt := hips * Vector3(-0.17 * _k, -0.03 * _k, 0.04 * _k)
	var over := gun * (MarkerModel.HOPPER_TOP + Vector3(-0.03, 0.15, 0.02))
	var hand: Vector3
	var pod_up := 1.0 # 1 the pod upright, -1 tipped into the hopper
	if p < 0.18:
		hand = grip.lerp(belt, smoothstep(0.0, 0.18, p))
	elif p < 0.32:
		hand = belt
	elif p < 0.55:
		var k := smoothstep(0.32, 0.55, p)
		hand = belt.lerp(over, k)
		pod_up = 1.0 - 2.0 * k
	elif p < 0.82:
		# Pouring: a little shake to get the last balls out.
		hand = over + Vector3.UP * 0.012 * sin(p * 90.0)
		pod_up = -1.0
	else:
		var k := smoothstep(0.82, 1.0, p)
		hand = over.lerp(grip, k)
		pod_up = -1.0 + 2.0 * k
	# Blend in and out with the pose's weight, so it never snaps.
	hand = grip.lerp(hand, smoothstep(0.0, 1.0, _reload_t))
	var dir := -gun.basis.z
	var turn := Basis(Vector3.UP, _gun_yaw)
	var fingers := (Vector3.DOWN * 0.6 + dir * 0.4 + turn * Vector3.RIGHT * 0.3).normalized()
	_hand_to(0, hand, fingers, turn * Vector3(-0.6, -1.0, 0.2))
	# The pod rides in the hand from when it's taken off the belt until
	# it's empty.
	var holding := p > 0.24 and p < 0.86 and reload >= 0.0
	if holding and _pod == null:
		_pod = MeshInstance3D.new()
		_pod.name = "PaintPod"
		_pod.mesh = MarkerModel.pod_mesh()
		skeleton.add_child(_pod)
	if _pod != null:
		_pod.visible = holding
		if holding:
			# Open end down into the hopper when tipped; the lid end in the
			# palm.
			var axis := (Vector3.UP * pod_up + dir * 0.25).normalized()
			var side := axis.cross(dir).normalized()
			if side.length_squared() < 0.01:
				side = Vector3.RIGHT
			var b := Basis(side, axis, side.cross(axis)).orthonormalized()
			_pod.transform = Transform3D(b, hand - axis * MarkerModel.POD_LENGTH * 0.5)


## Put a hand at `target` (in the skeleton's space), the fingers pointing
## along `fingers`, the elbow bending toward `pole`.
func _hand_to(side: int, target: Vector3, fingers: Vector3, pole: Vector3) -> void:
	var up := BodyBuilder.UPPER_ARM_L if side == 0 else BodyBuilder.UPPER_ARM_R
	var chest := skeleton.get_bone_global_pose(BodyBuilder.CHEST)
	var shoulder := chest * _rest[up]
	var l1 := _rest[up + 1].length()
	var l2 := _rest[up + 2].length()
	var ik := _two_bone(shoulder, target, l1, l2 + 0.07 * _k, pole)
	var elbow: Vector3 = ik[0]
	var reach: Vector3 = ik[1]
	var g_up := _aim(_rest[up + 1], elbow - shoulder)
	var g_low := _aim(_rest[up + 2], reach - elbow)
	var g_hand := _aim(_rest[up + 2], fingers)
	skeleton.set_bone_pose_rotation(up, (chest.basis.inverse() * g_up).get_rotation_quaternion())
	skeleton.set_bone_pose_rotation(up + 1, (g_up.inverse() * g_low).get_rotation_quaternion())
	skeleton.set_bone_pose_rotation(up + 2, (g_low.inverse() * g_hand).get_rotation_quaternion())


## Bone rotations [upper arm, forearm, hand] for holding the marker at
## `gun`: the right hand on the grip, the left out on the foregrip.
func _aim_arm(side: int, gun: Transform3D) -> Array:
	var up := BodyBuilder.UPPER_ARM_L if side == 0 else BodyBuilder.UPPER_ARM_R
	var chest := skeleton.get_bone_global_pose(BodyBuilder.CHEST)
	var shoulder := chest * _rest[up]
	var dir := -gun.basis.z
	var down := -gun.basis.y
	var l1 := _rest[up + 1].length()
	var l2 := _rest[up + 2].length()
	var palm := 0.07 * _k
	var target: Vector3
	var pole: Vector3
	var fingers: Vector3
	if side == 1:
		# The palm sits on the right of the grip, fingers round the front.
		target = gun * Vector3(0.025, -0.02, 0.02)
		pole = Vector3(0.7, -1.0, 0.25)
		fingers = (dir * 0.45 + down * 0.6 + gun.basis.x * -0.35).normalized()
	else:
		target = gun * (MarkerModel.FOREGRIP + Vector3(-0.025, -0.01, 0.0))
		pole = Vector3(-0.3, -1.0, 0.1)
		fingers = (dir * 0.6 + gun.basis.x * 0.5 + down * 0.35).normalized()
	var ik := _two_bone(shoulder, target, l1, l2 + palm, Basis(Vector3.UP, _gun_yaw) * pole)
	var elbow: Vector3 = ik[0]
	var reach: Vector3 = ik[1]
	var g_up := _aim(_rest[up + 1], elbow - shoulder)
	var g_low := _aim(_rest[up + 2], reach - elbow)
	var g_hand := _aim(_rest[up + 2], fingers)
	return [
		(chest.basis.inverse() * g_up).get_rotation_quaternion(),
		(g_up.inverse() * g_low).get_rotation_quaternion(),
		(g_low.inverse() * g_hand).get_rotation_quaternion(),
	]


## Put a foot on its spot on the floor: knee up and forward, sole flat.
func _reach_leg(side: int, ankle: Vector3) -> void:
	var leg := BodyBuilder.UPPER_LEG_L if side == 0 else BodyBuilder.UPPER_LEG_R
	var hips := skeleton.get_bone_global_pose(BodyBuilder.HIPS)
	var hip := hips * _rest[leg]
	var l1 := _rest[leg + 1].length()
	var l2 := _rest[leg + 2].length()
	var out := -1.0 if side == 0 else 1.0
	var ik := _two_bone(hip, ankle, l1, l2, Vector3(out * 0.12, 0.6, -1.0))
	var knee: Vector3 = ik[0]
	var foot: Vector3 = ik[1]
	var g_up := _aim(_rest[leg + 1], knee - hip)
	var g_low := _aim(_rest[leg + 2], foot - knee)
	# The foot keeps its rest direction (flat, toes forward), toes lifted a
	# little onto the pedal.
	var g_foot := Basis(Vector3.RIGHT, 0.25)
	skeleton.set_bone_pose_rotation(leg, (hips.basis.inverse() * g_up).get_rotation_quaternion())
	skeleton.set_bone_pose_rotation(leg + 1, (g_up.inverse() * g_low).get_rotation_quaternion())
	skeleton.set_bone_pose_rotation(leg + 2, (g_low.inverse() * g_foot).get_rotation_quaternion())


func _rot(bone: int, euler: Vector3) -> void:
	skeleton.set_bone_pose_rotation(bone, Quaternion.from_euler(euler))


# --- getting in and out of seats -------------------------------------------------------------

## s to climb in (from standing at the door to sat down) and out.
const CLIMB_IN := 1.2
const CLIMB_OUT := 1.0
## How fast they walk the last bit to the door first (m/s).
const CLIMB_WALK := 1.6


## True while getting into or out of a seat: the owner keeps them where
## they are until it's done.
func climbing() -> bool:
	return _climb_u >= 0.0


## Already put in a seat (the model's parent sat there, as if seated): climb
## in from where they were standing, `from` (world, usually their spot by
## the door before they were moved), past `door` (world: the door, on the
## ground) instead of appearing there. Butt first: back to the seat, sit on
## the sill ducking under the roof, then swing the legs in. Does nothing if
## the door's not beside the seat (the model just sits).
func climb_in(from: Vector3, door: Vector3) -> void:
	var parent := get_parent() as Node3D
	if parent == null or not parent.is_inside_tree() or skeleton == null:
		return
	var inv := parent.global_transform.affine_inverse()
	var d := inv * door
	if not _climb_ok(d):
		return
	var f := inv * from
	f.y = d.y
	_climb_seat = Transform3D.IDENTITY
	_climb_door = d
	_climb_from = f
	_climb_walk = minf(Vector2(f.x - d.x, f.z - d.z).length() / CLIMB_WALK, 1.2)
	_climb_yaw0 = 0.0
	if _climb_walk < 0.15:
		_climb_walk = 0.0
	else:
		_climb_yaw0 = atan2(-(d.x - f.x), -(d.z - f.z))
	_climb_u = 0.0
	_climb_dir = 1.0
	_climb_place()


## Already moved out (the model's parent standing beside the car): climb
## out from the seat they were in, `seat` (the model's world transform as
## it sat), to standing here. Does nothing if here isn't beside that seat
## (out the back of a van): they just stand up.
func climb_out(seat: Transform3D) -> void:
	var parent := get_parent() as Node3D
	if parent == null or not parent.is_inside_tree() or skeleton == null:
		return
	var local := parent.global_transform.affine_inverse() * seat
	local.basis = local.basis.orthonormalized()
	var d := local.affine_inverse() * Vector3.ZERO
	if not _climb_ok(d):
		return
	_climb_seat = local
	_climb_door = d
	_climb_walk = 0.0
	# Standing, they face the way their parent does.
	var fwd := local.basis.inverse() * Vector3.FORWARD
	_climb_yaw0 = atan2(-fwd.x, -fwd.z)
	_climb_u = 1.0
	_climb_dir = -1.0
	_climb_place()


## Stop climbing where they are (whatever the owner does next decides).
func end_climb() -> void:
	if _climb_u < 0.0:
		return
	_climb_u = -1.0
	transform = Transform3D.IDENTITY if _climb_dir < 0.0 else _climb_seat
	_target_speed = 0.0


## The door has to be out to one side of the seat, near it.
static func _climb_ok(door: Vector3) -> bool:
	return absf(door.x) > 0.3 and absf(door.x) < 2.4 and absf(door.z) < 1.6 and absf(door.y) < 1.3


func _climb_step(delta: float) -> void:
	if _climb_walk > 0.0:
		_climb_walk -= delta
		var d := Vector2(_climb_door.x - _climb_from.x, _climb_door.z - _climb_from.z).length()
		_target_speed = CLIMB_WALK if d > 0.05 else 0.0
		if _climb_walk <= 0.0:
			_climb_walk = 0.0
			_target_speed = 0.0
	else:
		_target_speed = 0.0
		_climb_u += _climb_dir * delta / (CLIMB_IN if _climb_dir > 0.0 else CLIMB_OUT)
		if _climb_u >= 1.0 and _climb_dir > 0.0 or _climb_u <= 0.0 and _climb_dir < 0.0:
			end_climb()
			return
	_climb_place()


## Where the body is along the climb, in the seated frame: across to the
## sill with the back to the seat, down onto it, in, and round to face
## ahead (the legs swing in over the sill with the turn).
func _climb_place() -> void:
	var u := clampf(_climb_u, 0.0, 1.0)
	var d := _climb_door
	var side := signf(d.x)
	var sill_x := side * 0.42 * _k
	var p: Vector3
	var yaw := 0.0
	if _climb_walk > 0.0:
		# The few steps to the door, facing the way they go.
		var total := minf(Vector2(_climb_from.x - d.x, _climb_from.z - d.z).length() / CLIMB_WALK, 1.2)
		var w := 1.0 - _climb_walk / maxf(total, 0.01)
		p = _climb_from.lerp(d, w)
		var go := d - _climb_from
		if Vector2(go.x, go.z).length() > 0.05:
			yaw = atan2(-go.x, -go.z)
	else:
		var a := smoothstep(0.0, 0.35, u)
		p = Vector3(lerpf(d.x, sill_x, a), 0.0, lerpf(d.z, 0.0, a))
		p.x = lerpf(p.x, 0.0, smoothstep(0.35, 0.8, u))
		p.y = lerpf(d.y, 0.0, smoothstep(0.22, 0.62, u))
		var out_yaw := -side * PI * 0.5
		yaw = lerp_angle(_climb_yaw0, out_yaw, smoothstep(0.05, 0.35, u))
		yaw = lerp_angle(yaw, 0.0, smoothstep(0.55, 0.95, u))
	transform = _climb_seat * Transform3D(Basis(Vector3.UP, yaw), p)


## The body along the climb, over the standing pose: sitting down as the
## hips go onto the seat, ducking under the roof, the door-side hand up
## on the door frame, and the knees lifted to swing the legs in.
func _climb_blend() -> void:
	if _climb_walk > 0.0:
		return
	var u := clampf(_climb_u, 0.0, 1.0)
	var side := signf(_climb_door.x)
	var sit := smoothstep(0.2, 0.62, u)
	var duck := sin(PI * clampf((u - 0.18) / 0.62, 0.0, 1.0))
	var lift := sin(PI * clampf((u - 0.52) / 0.42, 0.0, 1.0))
	var w_body := maxf(sit, duck)
	skeleton.set_bone_pose_position(BodyBuilder.HIPS, skeleton.get_bone_pose_position(BodyBuilder.HIPS).lerp(_rest[BodyBuilder.HIPS], sit))
	var to := {
		BodyBuilder.HIPS: [Vector3.ZERO, sit],
		BodyBuilder.SPINE: [Vector3(0.12 * sit - 0.5 * duck, 0.0, 0.0), w_body],
		BodyBuilder.CHEST: [Vector3(-0.22 * duck, 0.0, side * 0.1 * duck), w_body],
		BodyBuilder.NECK: [Vector3(-0.1 - 0.15 * duck, 0.0, 0.0), w_body],
		BodyBuilder.HEAD: [Vector3(0.25 * duck, side * -0.3 * duck, 0.0), w_body],
	}
	for s in 2:
		var leg := BodyBuilder.UPPER_LEG_L if s == 0 else BodyBuilder.UPPER_LEG_R
		var out := -1.0 if s == 0 else 1.0
		# Knees drawn up and in for the swing, so the feet come in over
		# the sill instead of sweeping through the door.
		to[leg] = [Vector3(1.4 + 0.75 * lift, 0.0, out * (0.08 - 0.06 * lift)), sit]
		to[leg + 1] = [Vector3(-1.25 - 0.85 * lift, 0.0, 0.0), sit]
		to[leg + 2] = [Vector3(0.1 + 0.3 * lift, 0.0, 0.0), sit]
		var arm := BodyBuilder.UPPER_ARM_L if s == 0 else BodyBuilder.UPPER_ARM_R
		var door_side := signf(out) == side
		if door_side:
			# A hand up on the door frame while ducking in.
			to[arm] = [Vector3(0.95 + 1.2 * duck, 0.0, out * (0.03 + 0.45 * duck)), w_body]
			to[arm + 1] = [Vector3(0.55 + 0.4 * duck, 0.0, 0.0), w_body]
		else:
			# The other on the seat, taking the weight.
			to[arm] = [Vector3(0.95 * sit - 0.3 * duck, 0.0, out * (0.03 + 0.25 * duck)), w_body]
			to[arm + 1] = [Vector3(0.55, 0.0, 0.0), w_body]
	for b: int in to:
		var e: Array = to[b]
		skeleton.set_bone_pose_rotation(b, skeleton.get_bone_pose_rotation(b).slerp(Quaternion.from_euler(e[0]), e[1]))
	# The door-side hand takes hold of the top of the door frame, just
	# behind the windscreen pillar, and keeps it there while they lower
	# themselves in (a fixed point on the car, not a wave in the air).
	var grip_w := smoothstep(0.08, 0.22, u) * (1.0 - smoothstep(0.62, 0.8, u))
	if grip_w > 0.001:
		var skin_x := _climb_door.x - side * 0.5 * _k
		var frame := Vector3(skin_x - side * 0.04 * _k, 1.5 * _k, -0.32 * _k)
		var at := transform.affine_inverse() * (_climb_seat * frame)
		var fingers := transform.basis.inverse() * (_climb_seat.basis * Vector3(-side * 0.3, 0.2, -1.0).normalized())
		var pole := transform.basis.inverse() * (_climb_seat.basis * Vector3(side, -1.0, 0.2))
		_hand_blend(0 if side < 0.0 else 1, at, fingers.normalized(), pole, grip_w)


# --- busy hands --------------------------------------------------------------------------------

## The business end of what's in the right hand (the bottle's or the
## nozzle's spray), world space, while a task with one is showing: its
## origin and -Z the way it points.
func prop_tip() -> Transform3D:
	return skeleton.global_transform * _tip if skeleton != null else global_transform


## Where a held hose runs over the body (world): from the nozzle's
## coupling back over the shoulder or under the arm to the small of the
## back, where it hangs down to the ground behind. Empty unless holding one.
func hose_points() -> Array[Vector3]:
	var out: Array[Vector3] = []
	if skeleton == null or _task_t <= 0.001 or not _task_now.begins_with("hose"):
		return out
	for p: Vector3 in _hose_pts:
		out.append(skeleton.global_transform * p)
	return out


## Eases between tasks (out of the old one, into the new), poses the one
## showing on top of whatever the body's doing, and shows its props.
func _task_pose(delta: float, sitting: bool) -> void:
	if task != _task_now:
		_task_t = move_toward(_task_t, 0.0, delta / 0.22)
		if _task_t <= 0.0:
			_task_now = task
	else:
		_task_t = move_toward(_task_t, 1.0 if task != "" else 0.0, delta / 0.35)
	var e := smoothstep(0.0, 1.0, _task_t)
	var props := ["", ""]
	_hose_pts.clear()
	if _task_now != "" and e > 0.001:
		var legs := not sitting and _climb_u < 0.0
		match _task_now:
			"radio":
				props = _radio_pose(e)
			"notepad":
				props = _notepad_pose(e)
			"phone":
				props = _phone_pose(e)
			"call":
				props = _call_pose(e)
			"arms_crossed":
				props = _arms_crossed_pose(e)
			"kneel", "rinse":
				if legs:
					props = _kneel_pose(e, _task_now == "rinse")
			"hose_drag":
				if legs:
					props = _hose_drag_pose(e)
			"hose":
				if legs:
					props = _hose_pose(e)
	for s in 2:
		# (A server draws nothing: no props.)
		var want: String = "" if TrafficDensity.server else props[s]
		var mi := _props[s]
		if want == "":
			if mi != null:
				mi.visible = false
			continue
		if mi == null:
			mi = MeshInstance3D.new()
			mi.name = "HandProp%s" % ("L" if s == 0 else "R")
			mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			WorldLod.limit(mi, 0.4, 60.0)
			skeleton.add_child(mi)
			_props[s] = mi
		mi.mesh = HandProps.mesh(want)
		mi.visible = true


## A prop held in hand `s` at `xf` (skeleton space).
func _prop_at(s: int, xf: Transform3D) -> void:
	if _props[s] != null:
		_props[s].transform = xf


## `task_at` in the skeleton's space (or a point `ahead` m in front at
## chest height when there's none).
func _task_local(ahead := 1.5) -> Vector3:
	if task_at == Vector3.INF:
		return Vector3(0.0, 1.0 * _k, -ahead)
	return skeleton.global_transform.affine_inverse() * task_at


## A hand to `target` as _hand_to does, blended from where the arm is by `e`.
func _hand_blend(side: int, target: Vector3, fingers: Vector3, pole: Vector3, e: float) -> void:
	var up := BodyBuilder.UPPER_ARM_L if side == 0 else BodyBuilder.UPPER_ARM_R
	var was: Array[Quaternion] = []
	for b in 3:
		was.append(skeleton.get_bone_pose_rotation(up + b))
	_hand_to(side, target, fingers, pole)
	for b in 3:
		skeleton.set_bone_pose_rotation(up + b, was[b].slerp(skeleton.get_bone_pose_rotation(up + b), e))


## A bone turned on from where it is, by `e`.
func _bend(bone: int, euler: Vector3, e: float) -> void:
	skeleton.set_bone_pose_rotation(bone, skeleton.get_bone_pose_rotation(bone).slerp(Quaternion.from_euler(euler), e))


## Where a point on the chest is now (the chest's own space, as a 1.75 m
## person: -Z is the front of the chest).
func _on_chest(p: Vector3) -> Vector3:
	return skeleton.get_bone_global_pose(BodyBuilder.CHEST) * (p * _k)


func _radio_pose(e: float) -> Array:
	# The mic's on the left shoulder strap: the left hand presses it, the
	# head turns down to it.
	_bend(BodyBuilder.NECK, Vector3(-0.12, 0.2, 0.1), e)
	_bend(BodyBuilder.HEAD, Vector3(-0.15, 0.3, 0.12), e)
	var mic := _on_chest(Vector3(-0.08, 0.1, -0.15))
	_hand_blend(0, mic, Vector3(0.85, 0.35, -0.2).normalized(), Vector3(-0.6, -1.0, 0.1), e)
	return ["", ""]


func _notepad_pose(e: float) -> Array:
	_bend(BodyBuilder.NECK, Vector3(-0.3, 0.0, 0.0), e)
	_bend(BodyBuilder.HEAD, Vector3(-0.3, 0.05, 0.0), e)
	var chest := skeleton.get_bone_global_pose(BodyBuilder.CHEST)
	var pad := chest * (Vector3(-0.04, -0.12, -0.3) * _k)
	# The pad tipped up toward the face, top away.
	var pad_b := chest.basis * Basis(Vector3.RIGHT, 0.75) * Basis(Vector3.UP, 0.25)
	_hand_blend(0, pad + pad_b * Vector3(-0.02, -0.02, 0.04), (pad_b * Vector3(0.6, 0.0, -0.8)).normalized(), Vector3(-0.8, -1.0, 0.2), e)
	# The pen scribbles across the page.
	var scrib := Vector3(sin(_t * 7.0) * 0.022 + 0.01, 0.0, sin(_t * 11.3) * 0.012 - 0.01)
	var pen_at := pad + pad_b * (scrib + Vector3(0.0, 0.03, 0.0))
	_hand_blend(1, pen_at + pad_b * Vector3(0.03, 0.04, 0.03), (pad_b * Vector3(-0.5, -0.5, -0.6)).normalized(), Vector3(1.0, -1.0, 0.3), e)
	_prop_at(0, Transform3D(pad_b, pad))
	var pen_b := Basis.looking_at((pen_at - (pen_at + pad_b * Vector3(0.05, 0.08, 0.06))).normalized(), pad_b.y)
	_prop_at(1, Transform3D(pen_b, pen_at - pen_b.z * 0.07))
	return ["notepad", "pen"]


func _phone_pose(e: float) -> Array:
	_bend(BodyBuilder.NECK, Vector3(-0.35, 0.0, 0.0), e)
	_bend(BodyBuilder.HEAD, Vector3(-0.3, 0.0, 0.0), e)
	var chest := skeleton.get_bone_global_pose(BodyBuilder.CHEST)
	var at := chest * (Vector3(0.0, -0.14, -0.28) * _k)
	var b := chest.basis * Basis(Vector3.RIGHT, 0.85)
	for s in 2:
		var x := -0.035 if s == 0 else 0.035
		_hand_blend(s, at + b * Vector3(x, -0.012, 0.03), (b * Vector3(-x * 6.0, 0.0, -1.0)).normalized(), Vector3(x * 20.0, -1.0, 0.2), e)
	# A thumb's scroll now and then.
	_prop_at(1, Transform3D(b, at))
	return ["", "phone"]


func _call_pose(e: float) -> Array:
	_bend(BodyBuilder.HEAD, Vector3(0.05, -0.1, -0.15), e)
	var head := skeleton.get_bone_global_pose(BodyBuilder.HEAD)
	var ear := head * (Vector3(0.1, 0.07, 0.0) * _k)
	_hand_blend(1, ear + head.basis * Vector3(0.035, -0.05, -0.02), (head.basis * Vector3(-0.25, 1.0, -0.2)).normalized(), Vector3(0.5, -1.0, -0.6), e)
	# The other hand on the hip, the way you stand on hold.
	var hips := skeleton.get_bone_global_pose(BodyBuilder.HIPS)
	_hand_blend(0, hips * (Vector3(-0.19, 0.06, -0.02) * _k), Vector3(0.3, -0.8, -0.3).normalized(), Vector3(-1.0, 0.0, 0.6), e)
	var b := head.basis * Basis(Vector3.FORWARD, -PI * 0.5) * Basis(Vector3.RIGHT, -0.3)
	_prop_at(1, Transform3D(b, ear + head.basis * Vector3(0.012, -0.02, -0.03)))
	return ["", "phone"]


func _arms_crossed_pose(e: float) -> Array:
	_bend(BodyBuilder.SPINE, Vector3(0.06, 0.0, 0.0), e)
	_bend(BodyBuilder.HEAD, Vector3(0.08, 0.0, 0.06), e)
	_hand_blend(0, _on_chest(Vector3(0.15, -0.06, -0.2)), Vector3(1.0, 0.1, 0.25).normalized(), Vector3(-1.0, -1.2, -0.3), e)
	_hand_blend(1, _on_chest(Vector3(-0.15, -0.02, -0.23)), Vector3(-1.0, 0.15, 0.25).normalized(), Vector3(1.0, -1.2, -0.3), e)
	return ["", ""]


## Down on the right knee, the left foot forward, leaning in to whoever's
## on the ground; `rinse` with a spray bottle in the right hand.
func _kneel_pose(e: float, rinse: bool) -> Array:
	var hips := skeleton.get_bone_pose_position(BodyBuilder.HIPS)
	skeleton.set_bone_pose_position(BodyBuilder.HIPS, hips.lerp(_rest[BodyBuilder.HIPS] + Vector3(0.0, -0.43 * _k, 0.06 * _k), e))
	_bend(BodyBuilder.HIPS, Vector3(0.0, 0.0, 0.0), e)
	_bend(BodyBuilder.UPPER_LEG_L, Vector3(1.5, 0.0, -0.12), e)
	_bend(BodyBuilder.LOWER_LEG_L, Vector3(-1.5, 0.0, 0.0), e)
	_bend(BodyBuilder.FOOT_L, Vector3(0.0, 0.0, 0.0), e)
	_bend(BodyBuilder.UPPER_LEG_R, Vector3(-0.12, 0.0, 0.06), e)
	_bend(BodyBuilder.LOWER_LEG_R, Vector3(-1.45, 0.0, 0.0), e)
	_bend(BodyBuilder.FOOT_R, Vector3(0.7, 0.0, 0.0), e)
	var at := _task_local(0.9)
	var chest := skeleton.get_bone_global_pose(BodyBuilder.CHEST)
	var to := at - chest.origin
	var down := atan2(-to.y, Vector2(to.x, to.z).length())
	_bend(BodyBuilder.SPINE, Vector3(-0.28, 0.0, 0.0), e)
	_bend(BodyBuilder.CHEST, Vector3(-0.12, 0.0, 0.0), e)
	_bend(BodyBuilder.NECK, Vector3(-clampf(down, -0.3, 0.8) * 0.4 + 0.25, 0.0, 0.0), e)
	_bend(BodyBuilder.HEAD, Vector3(-clampf(down, -0.3, 0.8) * 0.3, 0.0, 0.0), e)
	chest = skeleton.get_bone_global_pose(BodyBuilder.CHEST)
	var sh_r := chest * _rest[BodyBuilder.UPPER_ARM_R]
	var dir := (at - sh_r).normalized()
	if not rinse:
		# The right hand on them (a shoulder, a wrist), the left on the knee.
		var reach := sh_r + dir * minf(sh_r.distance_to(at), 0.62 * _k)
		reach.y += sin(_t * 1.3) * 0.01
		_hand_blend(1, reach, dir, Vector3(0.8, -1.0, 0.0), e)
		_hand_blend(0, Vector3(-0.14 * _k, 0.57 * _k, -0.36 * _k), Vector3(0.1, -0.6, -0.8).normalized(), Vector3(-1.0, 0.0, 0.3), e)
		return ["", ""]
	# Rinsing: the bottle out at arm's length at them, squeezed in time
	# with the spray, the left hand out flat to keep it off their face.
	var squeeze := 0.012 * sin(_t * 16.0)
	var hand := sh_r + dir * (0.48 * _k + squeeze) + Vector3(0.0, -0.02, 0.0)
	var b := Basis.looking_at(dir, Vector3.UP if absf(dir.y) < 0.95 else Vector3.FORWARD)
	_hand_blend(1, hand, (dir + Vector3.DOWN * 0.3).normalized(), Vector3(1.0, -1.0, 0.2), e)
	var sh_l := chest * _rest[BodyBuilder.UPPER_ARM_L]
	var dl := (at + Vector3.UP * 0.25 - sh_l).normalized()
	_hand_blend(0, sh_l + dl * 0.5 * _k, dl, Vector3(-1.0, -1.0, 0.0), e)
	var bottle := Transform3D(b, hand + b * Vector3(0.0, -0.04, 0.0))
	_prop_at(1, bottle)
	_tip = bottle * Transform3D(Basis.IDENTITY, HandProps.BOTTLE_TIP)
	return ["", "bottle"]


## Walking the hose out from the truck: over the right shoulder, both
## hands on it at the chest, leaning into the pull.
func _hose_drag_pose(e: float) -> Array:
	_bend(BodyBuilder.SPINE, Vector3(-0.22, 0.0, 0.0), e)
	_bend(BodyBuilder.CHEST, Vector3(-0.08, -0.15, 0.0), e)
	_bend(BodyBuilder.NECK, Vector3(0.25, 0.08, 0.0), e)
	var chest := skeleton.get_bone_global_pose(BodyBuilder.CHEST)
	var top := chest * (Vector3(0.13, 0.25, 0.02) * _k) # over the shoulder
	var r := chest * (Vector3(0.1, 0.12, -0.17) * _k)
	var l := chest * (Vector3(0.02, 0.0, -0.22) * _k)
	_hand_blend(1, r, Vector3(-0.2, -0.3, -0.9).normalized(), Vector3(1.0, -1.0, 0.0), e)
	_hand_blend(0, l, Vector3(0.6, -0.3, -0.7).normalized(), Vector3(-1.0, -1.0, 0.0), e)
	# The nozzle hangs off the front, pointing down.
	var nb := Basis.looking_at(Vector3(0.0, -1.0, -0.25).normalized(), Vector3.FORWARD)
	var noz := Transform3D(nb, l + Vector3(0.0, -0.06, -0.02))
	_prop_at(1, noz)
	_tip = noz * Transform3D(Basis.IDENTITY, HandProps.NOZZLE_TIP)
	var back := chest * (Vector3(0.12, -0.1, 0.16) * _k)
	_hose_pts = [noz * HandProps.NOZZLE_BACK, l, r, top, back]
	return ["", "nozzle"]


## On the nozzle: the left hand forward on the bale, the right on the
## pistol grip, the hose under the right arm. Aimed at `task_at`, braced
## (feet staggered, knees bent, leaning into it); with nowhere to aim, held
## low and pointed at the ground ahead, at the ready.
func _hose_pose(e: float) -> Array:
	var aimed := task_at != Vector3.INF
	var chest := skeleton.get_bone_global_pose(BodyBuilder.CHEST)
	var base := chest * (Vector3(0.11, -0.3, -0.24) * _k)
	var dir := Vector3(0.0, -0.75, -0.66).normalized()
	if aimed:
		var to := _task_local() - base
		var yaw := clampf(atan2(-to.x, -to.z), -0.5, 0.5)
		var pitch := clampf(atan2(to.y, Vector2(to.x, to.z).length()) + 0.12, -0.6, 0.7)
		dir = Vector3(-sin(yaw) * cos(pitch), sin(pitch), -cos(yaw) * cos(pitch))
		var brace := e
		var hips := skeleton.get_bone_pose_position(BodyBuilder.HIPS)
		skeleton.set_bone_pose_position(BodyBuilder.HIPS, hips.lerp(_rest[BodyBuilder.HIPS] + Vector3(0.0, -0.07 * _k, 0.02 * _k), brace))
		_bend(BodyBuilder.HIPS, Vector3(0.0, 0.25, 0.0), brace)
		_bend(BodyBuilder.UPPER_LEG_L, Vector3(0.5, 0.0, -0.1), brace)
		_bend(BodyBuilder.LOWER_LEG_L, Vector3(-0.45, 0.0, 0.0), brace)
		_bend(BodyBuilder.FOOT_L, Vector3(-0.05, 0.0, 0.0), brace)
		_bend(BodyBuilder.UPPER_LEG_R, Vector3(-0.35, 0.0, 0.12), brace)
		_bend(BodyBuilder.LOWER_LEG_R, Vector3(-0.3, 0.0, 0.0), brace)
		_bend(BodyBuilder.FOOT_R, Vector3(0.45, 0.0, 0.0), brace)
		_bend(BodyBuilder.SPINE, Vector3(-0.2, -0.15, 0.0), brace)
		_bend(BodyBuilder.CHEST, Vector3(-0.08, -0.1, 0.0), brace)
		_bend(BodyBuilder.NECK, Vector3(0.18, 0.12, 0.0), brace)
		_bend(BodyBuilder.HEAD, Vector3(0.05 + pitch * 0.3, 0.12, 0.0), brace)
		chest = skeleton.get_bone_global_pose(BodyBuilder.CHEST)
		base = chest * (Vector3(0.11, -0.3, -0.24) * _k)
		# The kick of the water: a little shake.
		base += Vector3(sin(_t * 23.0), sin(_t * 31.0), 0.0) * 0.004
	var nb := Basis.looking_at(dir, Vector3.UP)
	var noz := Transform3D(nb, base)
	var bale := noz * HandProps.NOZZLE_BALE
	var grip := noz * Vector3(0.0, -0.06, -0.03)
	_hand_blend(0, bale + nb * Vector3(-0.03, 0.03, 0.0), (nb * Vector3(0.6, -0.3, -0.5)).normalized(), Vector3(-1.0, -1.0, 0.2), e)
	_hand_blend(1, grip + nb * Vector3(0.025, 0.0, 0.01), (nb * Vector3(-0.3, -0.9, -0.2)).normalized(), Vector3(1.0, -0.6, 0.6), e)
	_prop_at(1, noz)
	_tip = noz * Transform3D(Basis.IDENTITY, HandProps.NOZZLE_TIP)
	var under := chest * (Vector3(0.21, -0.2, 0.02) * _k)
	var back := chest * (Vector3(0.16, -0.4, 0.15) * _k)
	_hose_pts = [noz * HandProps.NOZZLE_BACK, under, back]
	return ["", "nozzle"]


# --- construction ----------------------------------------------------------------------------

## The body's mesh, or none on a dedicated server (TrafficDensity.server),
## which draws nothing: the skeleton and pose (aim, seats, hits) are all it
## needs, and a body is some 13-18 ms and a few hundred KB.
static func _body_mesh(builder: BodyBuilder) -> ArrayMesh:
	return null if TrafficDensity.server else builder.make_mesh()

func _builder() -> BodyBuilder:
	var look := {
		"skin": skin, "hair": hair, "top": top, "under": under, "bottom": bottom,
		"shoes": shoes, "hair_style": hair_style, "hat": hat, "armour": armour_plates,
	}
	if not outfit.is_empty():
		look["outfit"] = outfit
	look.merge(face_extras)
	return BodyBuilder.new(look, height, build)


func _build() -> void:
	_k = height / 1.75
	var builder := _builder()
	if outfit.is_empty():
		outfit = builder.outfit
	skeleton = builder.make_skeleton()
	add_child(skeleton)
	for i in skeleton.get_bone_count():
		_rest.append(skeleton.get_bone_rest(i).origin)
	mesh_instance = MeshInstance3D.new()
	mesh_instance.name = "Body"
	if mesh_cache_key != "" and armour_plates == 0:
		if not _mesh_cache.has(mesh_cache_key):
			_mesh_cache[mesh_cache_key] = _body_mesh(builder)
		mesh_instance.mesh = _mesh_cache[mesh_cache_key]
	else:
		mesh_instance.mesh = _body_mesh(builder)
	skeleton.add_child(mesh_instance)
	mesh_instance.skeleton = NodePath("..")
	mesh_instance.skin = skeleton.create_skin_from_rest_transforms()
	if draw_distance > 0.0:
		mesh_instance.visibility_range_end = draw_distance
		mesh_instance.visibility_range_end_margin = 5.0
