; Engine configuration file.
; Godot 4 project for Trans-Canada Auto, an open-world driving game set in
; real Canadian places. First map: Sand Bar (Charlottetown, PEI).

config_version=5

[application]

config/name="Trans-Canada Auto"
config/description="Open-world driving game set in real Canadian places. First map: Sand Bar (Charlottetown, PEI)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://branding/icon.png"
boot_splash/bg_color=Color(0.0392, 0.0314, 0.0549, 1)
boot_splash/image="res://branding/splash.png"
boot_splash/stretch_mode=1
boot_splash/fullsize=true

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
GameState="*res://scripts/autoload/game_state.gd"
Graphics="*res://scripts/autoload/graphics.gd"
Sound="*res://scripts/autoload/sound.gd"
FieldNotes="*res://scripts/autoload/field_notes.gd"
TitleMenu="*res://scripts/autoload/title_menu.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[layer_names]

3d_physics/layer_1="ground"
3d_physics/layer_2="solid"
3d_physics/layer_3="vehicles"
3d_physics/layer_4="characters"
3d_physics/layer_5="boundary"
3d_physics/layer_6="cargo"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3

[shader_globals]

gfx_detail={
"type": "float",
"value": 1.0
}
