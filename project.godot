; Engine configuration file.
; Godot 4 project for the Charlottetown open-world prototype.

config_version=5

[application]

config/name="Charlottetown"
config/description="Small open-world driving prototype set in downtown Charlottetown, PEI."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
GameState="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[layer_names]

3d_physics/layer_1="ground"
3d_physics/layer_2="solid"
3d_physics/layer_3="vehicles"
3d_physics/layer_4="characters"
3d_physics/layer_5="boundary"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
